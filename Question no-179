class Solution {
public:
    string largestNumber(vector<int>& nums) {
        int n = nums.size();
        vector<string> arr;
        for(int i = 0; i < n; i++) {
            arr.push_back(to_string(nums[i]));
        }
        for(int i = 0; i < n; i++) {
            for(int j = i + 1; j < n; j++) {
                if(arr[j] + arr[i] > arr[i] + arr[j]) {
                    swap(arr[i], arr[j]);
                }
            }
        }
        if(arr[0] == "0")
            return "0";
        string ans = "";
        for(int i = 0; i < n; i++) {
            ans += arr[i];
        }
        return ans;
    }
};
