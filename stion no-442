import java.util.*;

class Solution {
    public List<Integer> findDuplicates(int[] nums) {
        HashMap<Integer, Integer> mpp = new HashMap<>();
        List<Integer> temp = new ArrayList<>();
        for (int i = 0; i < nums.length; i++) {
            if (mpp.containsKey(nums[i])) {
                temp.add(nums[i]);
            }
            else {
                mpp.put(nums[i], 1);
            }
        }
        return temp;
    }
}
