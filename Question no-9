class Solution {
public:
    bool isPalindrome(int x){
        if(x>INT_MAX||x<INT_MIN){
            return false;
        }
        long long temp=x;
        long long sum=0;
        if(x<0){
            return false;
        }
        while(temp!=0){
            long long digit=temp%10;
            sum=sum*10+digit;
            temp/=10;
        }
        if(sum==x){
            return true;
        }
    return false;}
};
