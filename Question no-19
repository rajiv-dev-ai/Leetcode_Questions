class Solution {
public:
ListNode* removeNthFromEnd(ListNode* head, int n) {
int cnt = 0;
ListNode* temp = head;
    while (temp != NULL) {
        cnt++;
        temp = temp->next;
    }
    int pos = cnt - n;
    if (pos == 0) {
        return head->next;
    }
    temp = head;
    for (int i = 1; i < pos; i++) {
        temp = temp->next;
    }
    temp->next = temp->next->next;
    return head;
   }
};
