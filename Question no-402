class Solution {
public:
    string removeKdigits(string num, int k) {
    string ans;
    for(int i=0;i<num.size();i++){
        while(!ans.empty()&&k>0&&ans.back()>num[i]){
            ans.pop_back();
            k--;
        }
    if(!ans.empty()||num[i]!='0'){
        ans.push_back(num[i]);
        }
    }
    while(k>0&&!ans.empty()){
        ans.pop_back();
        k--;
    }
    if(ans.empty()){
        return "0";
    }
    return ans;
    }
};
